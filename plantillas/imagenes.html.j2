<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "Schibsted Grotesk"; font-weight: 400 900; src: url("{{ base }}assets/fuentes/schibsted-grotesk.woff2") format("woff2"); }
  @font-face { font-family: "Fragment Mono"; font-weight: 400; src: url("{{ base }}assets/fuentes/fragment-mono-400.woff2") format("woff2"); }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { width: 1200px; background: transparent; }

  /* Encabezado: estilo A · Laboratorio del portafolio, en petróleo (el mismo en tema claro y oscuro) */
  .enc { position: relative; width: 1200px; height: 264px; background: #0F5E66; color: #FFFFFF; }
  .marca { position: absolute; left: 56px; top: 42px; display: flex; align-items: center; gap: 20px; }
  .marca svg { display: block; }
  .marca span { font: 400 30px/1 "Fragment Mono", monospace; letter-spacing: .06em; }
  h1 { position: absolute; left: 53px; bottom: 36px; font: 700 104px/1 "Schibsted Grotesk", sans-serif; letter-spacing: -.025em; white-space: nowrap; }

  /* Fichas de logos: cada logo va tal cual, sobre blanco, para que se lea igual en tema claro y oscuro */
  .fichas { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 24px; width: 1200px; padding: 24px; }
  .ficha { display: flex; align-items: center; gap: 14px; height: 52px; padding: 0 16px; background: #FFFFFF; border-radius: 6px; }
  .ficha img { display: block; }
</style>
</head>
<body>

{# El encabezado: solo la marca (nodo + sigla) y el nombre. Todo lo demás del README va en texto. #}
<section class="enc" data-nombre="encabezado">
  <div class="marca">
    <svg width="74" height="28" viewBox="0 0 32 12" aria-hidden="true"><circle cx="5" cy="6" r="5" fill="currentColor"/><path d="M10 6H24" stroke="currentColor" stroke-width="1.5"/><circle cx="28" cy="6" r="3.25" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
    <span>{{ s.sitio.marca }}</span>
  </div>
  <h1>{{ s.sitio.nombre }}</h1>
</section>

<div class="fichas">
  {% for f in fichas %}
  <div class="ficha" data-nombre="logo-{{ f.clave }}">{% for l in f.logos %}<img src="{{ logos[l].src }}" width="{{ logos[l].ancho }}" height="{{ logos[l].alto }}" alt="">{% endfor %}</div>
  {% endfor %}
</div>

</body>
</html>

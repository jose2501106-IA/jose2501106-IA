<!doctype html>
<html lang="es" data-tema="{{ tema }}">
<head>
<meta charset="utf-8">
<style>
  @font-face { font-family: "Space Mono"; font-weight: 400; src: url("{{ base }}assets/fuentes/space-mono-400.woff2") format("woff2"); }
  @font-face { font-family: "Space Mono"; font-weight: 700; src: url("{{ base }}assets/fuentes/space-mono-700.woff2") format("woff2"); }
  @font-face { font-family: "Titillium Web"; font-weight: 600; src: url("{{ base }}assets/fuentes/titillium-web-600.woff2") format("woff2"); }
  /* Tema claro: el mismo plano del portafolio */
  :root {
    --fondo: #FFFFFF; --rej-1: #E3E9F5; --rej-2: #F3F6FB;
    --tinta: #0B1F4A; --acento: #0046B8; --vivo: #1166F2; --gris: #5A6F9A; --cota: #9DB3DE;
    --pie: rgba(255, 255, 255, .92); --barra: #0046B8; --sello: #0046B8; --rej-marco: rgba(0, 70, 184, .1);
  }
  /* Tema oscuro: plano azul marino, para quien usa GitHub en modo oscuro */
  :root[data-tema="oscuro"] {
    --fondo: #0B1F4A; --rej-1: rgba(157, 179, 222, .18); --rej-2: rgba(157, 179, 222, .07);
    --tinta: #F3F7FF; --acento: #8FB4FF; --vivo: #8FB4FF; --gris: #9DB3DE; --cota: #5A6F9A;
    --pie: rgba(11, 31, 74, .9); --barra: #0046B8; --sello: #1166F2; --rej-marco: rgba(157, 179, 222, .12);
  }
  * { box-sizing: border-box; margin: 0; }
  html, body { width: 1200px; height: 630px; }
  body {
    position: relative; overflow: hidden; background-color: var(--fondo); color: var(--tinta); font-family: "Titillium Web", sans-serif;
    background-image: linear-gradient(var(--rej-1) 1px, transparent 1px), linear-gradient(90deg, var(--rej-1) 1px, transparent 1px),
                      linear-gradient(var(--rej-2) 1px, transparent 1px), linear-gradient(90deg, var(--rej-2) 1px, transparent 1px);
    background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
  }
  .meta { position: absolute; left: 64px; right: 64px; top: 40px; display: flex; justify-content: space-between; font: 15px "Space Mono"; letter-spacing: 2px; color: var(--gris); }
  .texto { position: absolute; left: 64px; top: 112px; width: 640px; display: flex; flex-direction: column; gap: 18px; }
  .kicker { font: 17px "Space Mono"; letter-spacing: 3px; color: var(--acento); }
  .cota { display: flex; align-items: center; gap: 10px; font: 12px "Space Mono"; color: var(--gris); }
  .cota i { flex: 1; border-top: 1.5px dashed var(--cota); }
  h1 { font: 700 96px/.96 "Space Mono"; letter-spacing: -3px; }
  .sub { font-size: 34px; line-height: 1.2; font-weight: 600; text-wrap: balance; }
  .bajada { font-size: 21px; line-height: 1.35; font-weight: 600; color: var(--vivo); text-wrap: balance; }
  .foto { position: absolute; right: 64px; top: 92px; width: 352px; padding: 20px; }
  .foto .esq { position: absolute; width: 22px; height: 22px; border: 0 solid var(--acento); }
  .ti { top: 0; left: 0; border-top-width: 2.5px !important; border-left-width: 2.5px !important; }
  .td { top: 0; right: 0; border-top-width: 2.5px !important; border-right-width: 2.5px !important; }
  .bi { bottom: 0; left: 0; border-bottom-width: 2.5px !important; border-left-width: 2.5px !important; }
  .bd { bottom: 0; right: 0; border-bottom-width: 2.5px !important; border-right-width: 2.5px !important; }
  .marco { position: relative; border: 2px solid var(--acento); background: var(--fondo); }
  .lamina { aspect-ratio: 4 / 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding-bottom: 36px; }
  .sello { width: 184px; height: 184px; display: grid; place-items: center; background: var(--sello); color: #FFFFFF; font: 700 64px/1 "Space Mono"; letter-spacing: -1px; }
  .cota-h { width: 184px; display: flex; align-items: center; gap: 8px; font: 11px "Space Mono"; letter-spacing: 1px; color: var(--gris); }
  .cota-h::before, .cota-h::after { content: ""; flex: 1; border-top: 1.5px dashed var(--cota); }
  .fig { font: 12px "Space Mono"; letter-spacing: 2px; color: var(--gris); }
  .marco .rej { position: absolute; inset: 0; background-image: linear-gradient(var(--rej-marco) 1px, transparent 1px), linear-gradient(90deg, var(--rej-marco) 1px, transparent 1px); background-size: 20% 20%; pointer-events: none; }
  .marco .pie { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; padding: 7px 10px; background: var(--pie); border-top: 2px solid var(--acento); font: 11px "Space Mono"; letter-spacing: 1.5px; color: var(--acento); }
  .barra { position: absolute; left: 0; right: 0; bottom: 0; height: 64px; padding: 0 64px; display: flex; align-items: center; justify-content: space-between; background: var(--barra); color: #FFFFFF; font: 700 19px "Space Mono"; letter-spacing: 1px; }
  .barra span:last-child { font-weight: 400; font-size: 15px; letter-spacing: 2px; opacity: .85; }
</style>
</head>
<body>
  <div class="meta"><span>{{ hoja }} 00 / PERFIL</span><span>{{ escala }} 1:1 · REV {{ anio }}</span></div>
  <div class="texto">
    <div class="kicker">{{ kicker }}</div>
    <div>
      <div class="cota"><span>y 000</span><i></i></div>
      <h1>{{ nombre[0] }}<br>{{ nombre[1] }}</h1>
      <div class="cota" style="margin-top:8px"><span>y 196</span><i></i></div>
    </div>
    <div class="sub">{{ sub }}</div>
    <div class="bajada">{{ bajada|replace(" · ", "&nbsp;· "|safe) }}</div>
  </div>
  <div class="foto">
    <span class="esq ti"></span><span class="esq td"></span><span class="esq bi"></span><span class="esq bd"></span>
    <div class="marco"><div class="lamina"><div class="sello">{{ marca }}</div><div class="cota-h"><span>1:1</span></div><div class="fig">FIG. 00 — MARCA</div></div><div class="rej"></div><div class="pie"><span>{{ pie_izq }}</span><span>{{ pie_der }}</span></div></div>
  </div>
  <div class="barra"><span>{{ dominio }}</span><span>ES · EN</span></div>
</body>
</html>

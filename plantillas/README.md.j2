<!-- Generado por scripts/generar_readme.py desde data/perfil.yml del portafolio. No lo edites a mano: cambia perfil.yml y vuelve a generar. -->

{{ lamina("encabezado", s.sitio.url) }}

<p align="center">
  <a href="{{ s.sitio.url }}"><b>Portafolio</b></a> ·
  <a href="{{ s.sitio.url }}en/">English</a> ·
  <a href="{{ s.contacto.linkedin_url }}">LinkedIn</a> ·
  <a href="{{ s.sitio.url }}{{ t(s.cv.archivo) }}">{{ t(s.cv.nav) }} (PDF)</a> ·
  <a href="mailto:{{ s.contacto.correo }}">{{ s.contacto.correo }}</a> ·
  {{ t(s.contacto.ubicacion) }}
</p>

{{ t(s.portada.historia) }}

{{ lamina("roles") }}

{{ lamina("proyectos") }}
{% for p in s.proyectos %}

{{ lamina(p.codigo|lower, p.enlaces[0].url if p.enlaces else none) }}

<p align="right"><sub>{% if p.enlaces %}{% for l in p.enlaces %}<a href="{{ l.url }}">{{ p.codigo }} · {{ t(l.texto) }} →</a>{{ " · " if not loop.last }}{% endfor %}{% else %}{{ p.codigo }} · {{ t(s.ui.privado) }}{% endif %}</sub></p>
{% endfor %}

{{ lamina("herramientas") }}

{{ lamina("formacion") }}

{% for f in s.perfil.formacion if f.verificar is defined %}
<p align="right"><sub><a href="{{ f.verificar }}">{{ t(f.institucion) }} · {{ t(s.ui.verificar) }} →</a></sub></p>
{% endfor %}

{{ lamina("contacto", s.sitio.url ~ "#contacto") }}

<p align="center">
  <a href="mailto:{{ s.contacto.correo }}"><b>{{ s.contacto.correo }}</b></a> ·
  <a href="{{ s.contacto.linkedin_url }}">{{ s.contacto.linkedin_txt }}</a> ·
  <a href="{{ s.sitio.url }}{{ t(s.cv.archivo) }}">{{ t(s.cv.boton) }}</a> ·
  <a href="{{ s.sitio.url }}">Portafolio</a>
</p>

<br>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="{{ serpiente }}/github-snake-dark.svg">
  <img src="{{ serpiente }}/github-snake.svg" width="100%" alt="Mis contribuciones en GitHub del último año, recorridas por una serpiente">
</picture>

<p align="center"><i>{{ t(s.pie.frase) }}</i></p>

<p align="center"><sub>Este README se genera desde <code>perfil.yml</code>, la misma fuente que usa el portafolio.</sub></p>

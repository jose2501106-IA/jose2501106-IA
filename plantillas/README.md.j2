<!-- Generado por scripts/generar_readme.py desde data/perfil.yml del portafolio. No lo edites a mano: cambia perfil.yml y vuelve a generar. -->
{# Todo va en texto y en tablas de dos columnas: caben en un celular sin recorrerlas de lado.
   Dentro de una tabla no puede quedar ningún renglón vacío (GitHub cortaría el bloque HTML). #}
{% macro chips(lista) %}{% for h in lista %}<code>{{ t(h)|e }}</code>{{ " " if not loop.last }}{% endfor %}{% endmacro %}
{% macro fuente(c) %}{{ t(s.ui.fuente) }} {% if c.fuente.url is defined %}<a href="{{ c.fuente.url }}">{{ t(c.fuente.corta)|e }}</a>{% else %}{{ t(c.fuente.corta)|e }}{% endif %}{% endmacro %}
{% macro fila_logos(fichas) %}<p>{% for f in fichas %}<img src="assets/logos/{{ f.clave }}.webp" height="52" alt="{{ f.alt|e }}">{{ "&nbsp; " if not loop.last }}{% endfor %}</p>{% endmacro %}

<a href="{{ s.sitio.url }}"><img src="assets/encabezado.webp" width="100%" alt="{{ alt_encabezado|e }}"></a>

<p align="center">
  <sub>{{ t(s.portada.linea_superior)|e }}</sub><br>
  <b>{{ t(s.portada.subtitulo)|e }}</b><br>
  {{ t(s.portada.bajada)|e }}
</p>

<p align="center">
  <a href="{{ s.sitio.url }}"><b>Portafolio</b></a> ·
  <a href="{{ s.sitio.url }}en/">English</a> ·
  <a href="{{ s.contacto.linkedin_url }}">LinkedIn</a> ·
  <a href="{{ s.sitio.url }}{{ t(s.cv.archivo) }}">{{ t(s.cv.nav) }} (PDF)</a> ·
  <a href="mailto:{{ s.contacto.correo }}">{{ s.contacto.correo }}</a> ·
  {{ t(s.contacto.ubicacion) }}
</p>

{{ t(s.portada.historia) }}

<table>
{% for c in s.portada.cifras %}
<tr><th scope="row" align="right" valign="top">{{ t(c.valor)|e }}</th><td valign="top" width="100%">{{ t(c.texto)|e }}<br><sub><code>{{ c.codigo }}</code> · {{ fuente(c) }}</sub></td></tr>
{% endfor %}
</table>

{% if logro %}
{% set l = logro.lamina %}
## {{ t(logro.puesto) }}: {{ t(l.titulo) }}

<sub>{{ t(logro.etiqueta) }} · {{ t(logro.lugar) }}</sub>

**{{ t(l.equipo) }}.** {{ t(l.propuesta) }}

<table>
<tr><th scope="row" align="left" valign="top" width="34%">{{ oracion(t(l.metodo))|e }}</th><td valign="top">{% for p in l.pasos %}<b>{{ t(p.valor)|e }}</b> · {{ t(p.texto)|e }}{{ "<br>" if not loop.last }}{% endfor %}</td></tr>
{% for f in l.ficha %}
<tr><th scope="row" align="left" valign="top">{{ oracion(t(f.et))|e }}</th><td valign="top">{{ t(f.valor)|e }}</td></tr>
{% endfor %}
</table>

<sub>{{ t(l.nota).lstrip("/ ") }} · <a href="{{ l.enlace.url }}">{{ t(l.enlace.texto) }} →</a></sub>
{% endif %}

## {{ t(s.secciones.roles.titulo) }}

<table>
{% for r in s.roles %}
<tr><th scope="row" align="left" valign="top" width="30%"><code>{{ r.codigo }}</code><br>{{ t(r.titulo)|e }}</th><td valign="top">{{ t(r.texto)|e }}<br><sub>{{ t(s.ui.evidencia) }}</sub> {% for e in r.evidencia %}<code>{{ e }}</code> {% endfor %}{% for x in r.evidencia_extra|default([]) %}· <a href="{{ s.sitio.url }}#{{ x.ancla }}">{{ t(x.texto)|e }}</a>{% endfor %}</td></tr>
{% endfor %}
</table>

<code>{{ t(s.como_trabajo)|e }}</code>

## {{ t(s.secciones.proyectos.titulo) }}

<table>
{% for p in s.proyectos %}
<tr>
<td valign="top" width="46%"><sub><code>{{ p.codigo }}</code> · {% for c in p.categorias %}{{ t(s.categorias[c].fig) }}{{ " · " if not loop.last }}{% endfor %}</sub><br><b>{{ t(p.nombre)|e }}</b><br>{{ t(p.subtitulo)|e }}<br><sub>{% if p.enlaces %}{% for en in p.enlaces %}<a href="{{ en.url }}">{{ t(en.texto)|e }} →</a>{{ " · " if not loop.last }}{% endfor %}{% else %}{{ t(s.ui.privado) }}{% endif %}</sub></td>
<td valign="top"><b>{{ t(p.estado) }}</b><br>{% if p.distinciones is defined %}{% for d in p.distinciones.premios %}{{ t(d.titulo)|e }}<br>{% endfor %}{% else %}{% for c in p.cifras %}<b>{{ t(c.valor)|e }}</b> {{ t(c.texto)|e }}<br>{% endfor %}{% endif %}{{ chips(p.tecnologias) }}</td>
</tr>
{% endfor %}
</table>

<p align="right"><sub><a href="{{ s.sitio.url }}#proyectos">Ver en el portafolio →</a></sub></p>

{# Las tres secciones que siguen van plegadas: el detalle completo se abre con un clic. #}
## {{ oracion(t(s.ui.herramientas)) }}

<details>
<summary>{% for g in s.perfil.herramientas %}{{ oracion(t(g.grupo))|e }} · {% endfor %}{{ oracion(t(s.ui.idiomas)) }} · {{ oracion(t(s.ui.habilidades_blandas)) }}</summary>
<br>

<table>
{% for g in s.perfil.herramientas %}
<tr><th scope="row" align="left" valign="top" width="26%">{{ oracion(t(g.grupo))|e }}</th><td>{{ chips(g.lista) }}</td></tr>
{% endfor %}
<tr><th scope="row" align="left" valign="top">{{ oracion(t(s.ui.idiomas)) }}</th><td>{{ s.perfil.idiomas|map("t")|join("<br>") }}</td></tr>
<tr><th scope="row" align="left" valign="top">{{ oracion(t(s.ui.habilidades_blandas)) }}</th><td>{{ t(s.perfil.habilidades_blandas)|e }}</td></tr>
</table>

</details>

## {{ oracion(t(s.ui.formacion_programas)) }}

{{ fila_logos(fichas_formacion) }}

<details>
<summary>Ver los {{ s.perfil.formacion|length }} programas</summary>
<br>

<table>
{% for f in s.perfil.formacion %}
<tr><th scope="row" align="left" valign="top" width="36%">{{ t(f.institucion)|e }}</th><td valign="top">{{ t(f.programa)|e }}<br>{% if f.fases is defined %}{% for fa in f.fases %}<b>{{ t(fa.nombre)|e }}</b> · {{ t(fa.estado)|e }}{% if fa.verificar is defined %} · <a href="{{ fa.verificar }}">{{ t(s.ui.verificar) }} →</a>{% endif %}{{ "<br>" if not loop.last }}{% endfor %}{% else %}{{ t(f.estado)|e }}{% if f.verificar is defined %} · <a href="{{ f.verificar }}">{{ t(s.ui.verificar) }} →</a>{% endif %}{% endif %}</td></tr>
{% endfor %}
</table>

</details>

## {{ oracion(t(s.ui.oratoria_comunidad)) }}

{{ fila_logos(fichas_oratoria) }}

<details>
<summary>Ver los {{ s.perfil.oratoria_comunidad|length }} registros</summary>
<br>

<table>
{% for f in s.perfil.oratoria_comunidad %}
<tr><th scope="row" align="left" valign="top" width="36%">{{ t(f.institucion)|e }}</th><td valign="top">{{ t(f.programa)|e }}<br>{{ t(f.estado)|e }}{% if f.documento is defined %}<br><a href="{{ s.sitio.url }}{{ f.documento }}">{{ t(s.ui.ver_reconocimiento) }} →</a>{% endif %}</td></tr>
{% endfor %}
</table>

<p align="right"><sub><a href="{{ s.sitio.url }}#perfil">Ver en el portafolio →</a></sub></p>

</details>

## {{ t(s.seccion_contacto.titulo) }}

{{ t(s.seccion_contacto.texto) }}

<table>
<tr><th scope="row" align="left">{{ t(s.seccion_contacto.filas.correo) }}</th><td><a href="mailto:{{ s.contacto.correo }}">{{ s.contacto.correo|replace("@", "@<wbr>") }}</a></td></tr>
<tr><th scope="row" align="left">{{ t(s.seccion_contacto.filas.linkedin) }}</th><td><a href="{{ s.contacto.linkedin_url }}">{{ s.contacto.linkedin_txt }}</a></td></tr>
<tr><th scope="row" align="left">{{ t(s.seccion_contacto.filas.cv) }}</th><td><a href="{{ s.sitio.url }}{{ t(s.cv.archivo) }}">{{ t(s.cv.boton) }}</a></td></tr>
<tr><th scope="row" align="left">{{ t(s.ui.marca_sub) }}</th><td><a href="{{ s.sitio.url }}#contacto">{{ dominio }}</a></td></tr>
<tr><th scope="row" align="left">{{ t(s.seccion_contacto.filas.ubicacion) }}</th><td>{{ t(s.contacto.ubicacion) }}</td></tr>
</table>

<p align="center"><i>{{ t(s.pie.frase) }}</i></p>

<p align="center"><sub>Este README se genera desde <code>perfil.yml</code>, la misma fuente que usa el portafolio.</sub></p>
